<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/configure_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E12"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Header bar with title and close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Album Display Widget"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose an album to display and rotate on your home screen."
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image Preview Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMAGE PREVIEW"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp">

                <FrameLayout
                    android:id="@+id/preview_card_container"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/widget_preview_bg"
                    android:clipToOutline="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <!-- Image Preview -->
                    <ImageView
                        android:id="@+id/iv_widget_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Widget Photo Preview" />

                    <!-- Empty State Container -->
                    <LinearLayout
                        android:id="@+id/preview_empty_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_close"
                            android:alpha="0.4"
                            android:contentDescription="Empty" />

                        <TextView
                            android:id="@+id/tv_preview_empty_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="No photos in album"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Bottom Gradient Overlay with Album info -->
                    <LinearLayout
                        android:id="@+id/preview_info_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/widget_controls_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tv_preview_album_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_preview_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#CBD5E1"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- Album Selection Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT ALBUM"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_bg"
                android:padding="12dp">

                <Spinner
                    android:id="@+id/spinner_album"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:popupBackground="#1E2130" />
            </LinearLayout>

            <!-- Shuffle Mode Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="SHUFFLE ORDER"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <RadioGroup
                android:id="@+id/radio_group_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_bg"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/radio_random"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Random Shuffle"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="@color/radio_button_tint" />

                <RadioButton
                    android:id="@+id/radio_ordered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ordered (Sequential)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="@color/radio_button_tint" />
            </RadioGroup>

            <!-- Shuffle Interval Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ROTATION INTERVAL"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/card_bg"
                android:padding="12dp">

                <Spinner
                    android:id="@+id/spinner_interval"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:popupBackground="#1E2130" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="vertical">

        <!-- Shuffle Now Button (Primary) -->
        <Button
            android:id="@+id/btn_shuffle_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/btn_primary_bg"
            android:text="Shuffle Now"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Open Wall Tap Button (Secondary) -->
        <Button
            android:id="@+id/btn_open_app"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_secondary_bg"
            android:text="Open Wall Tap"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
