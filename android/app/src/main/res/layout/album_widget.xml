<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/album_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Album photo displayed on widget with transition animation -->
    <ViewFlipper
        android:id="@+id/widget_album_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <ImageView
            android:id="@+id/widget_album_image_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Album Photo" />

        <ImageView
            android:id="@+id/widget_album_image_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Album Photo" />
    </ViewFlipper>

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/widget_album_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_album_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="No photos in album\nTap to configure"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Controls Overlay Bar: Shown when user taps the widget, hidden by default -->
    <LinearLayout
        android:id="@+id/widget_album_controls_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_controls_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <!-- Settings Button -->
        <ImageView
            android:id="@+id/btn_album_widget_settings"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_settings"
            android:contentDescription="Settings"
            android:scaleType="centerInside" />

        <!-- Next Image Button -->
        <ImageView
            android:id="@+id/btn_album_widget_next"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next Image"
            android:scaleType="centerInside" />
    </LinearLayout>

</RelativeLayout>
