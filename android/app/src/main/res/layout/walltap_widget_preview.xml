<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Wallpaper Sample Image -->
    <ImageView
        android:id="@+id/widget_wallpaper_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/sample_wallpaper_shuffle"
        android:scaleType="centerCrop"
        android:contentDescription="Next Wallpaper" />

    <!-- Next Badge in top-left -->
    <LinearLayout
        android:id="@+id/widget_badge_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_badge_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT"
            android:textColor="#F0F4F8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Bottom Controls Bar with gradient -->
    <LinearLayout
        android:id="@+id/widget_controls_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_controls_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_widget_settings"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_settings"
            android:contentDescription="Settings"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/btn_widget_next"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next Wallpaper"
            android:scaleType="centerInside" />
    </LinearLayout>

</RelativeLayout>

